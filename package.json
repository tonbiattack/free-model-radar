{
  "name": "free-model-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode などのコーディングエージェントから使える無料枠つき LLM API を、出典と検証状態つきで比較する静的サイト",
  "scripts": {
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && npm run i18n:extract && npm run i18n:build && npm run check:i18n && tsc --noEmit && vite build && tsx scripts/postbuild.ts && tsx scripts/prerender.ts && tsx scripts/sitemap.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:data": "tsx scripts/build-data.ts",
    "i18n:extract": "tsx scripts/extract-i18n.ts",
    "i18n:build": "tsx scripts/build-i18n.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "check": "npm run lint && npm run build:data && npm run test && npm run build",
    "verify:models": "tsx scripts/verify-models.ts",
    "watch:changes": "tsx scripts/watch-changes.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
